# stray-bev1 environment variables
# Copy this file to .env and fill in your values.
# Secrets and connection settings only. Balance numbers live in balance_config.

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=runstray
DB_USER=postgres
DB_PASSWORD=change_me

# Server
PORT=2567
NODE_ENV=development

# Admin battle lab (dev only, localhost). Never enable in production.
ADMIN_ENABLED=false
ADMIN_PORT=8787
ADMIN_TOKEN=change_me_to_a_long_random_string

# Game server (Step 2b): dev join by name, local only. Never true in production.
DEV_JOIN=true
GAME_PORT=2567
CLIENT_ORIGIN=http://localhost:5173
