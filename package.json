{
  "name": "stray-bev1",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "db:migrate": "node --env-file=.env server/db/migrate.ts",
    "db:seed": "node --env-file=.env server/db/seed.ts",
    "db:check": "node --env-file=.env server/db/check.ts",
    "tiles:export": "node --env-file=.env server/tiles/export.ts",
    "db:setup": "npm run db:migrate && npm run db:seed && npm run db:check",
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "sim": "node --env-file=.env server/sim/run_battle.ts",
    "sim:world": "node --env-file=.env server/sim/world_sim.ts",
    "sim:town": "node --env-file=.env server/sim/town_sim.ts",
    "session": "node --env-file=.env server/sim/session.ts",
    "play": "node --env-file=.env server/sim/play.ts",
    "admin": "node --env-file=.env server/admin/server.ts",
    "game": "node --env-file=.env server/game/server.ts",
    "world:new": "node --env-file=.env server/worldgen/new_world.ts",
    "world:dev": "node --env-file=.env server/worldgen/dev_world.ts",
    "world:roster": "node --env-file=.env server/sim/roster.ts",
    "world:ticks": "node --env-file=.env server/admin/world/run_ticks.ts",
    "dev:veteran": "node --env-file=.env server/sim/veteran.ts"
  },
  "dependencies": {
    "@colyseus/core": "0.18.19",
    "@colyseus/schema": "5.0.40",
    "@colyseus/ws-transport": "0.18.4",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "typescript": "6.0.3"
  }
}
